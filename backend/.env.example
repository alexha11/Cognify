# Database (PostgreSQL 16 with the pgvector extension)
DATABASE_URL="postgresql://cognify:cognify_local_password@localhost:5432/cognify?schema=public"

# JWT — must be at least 32 characters (enforced at startup).
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-generate-with-openssl-rand-base64-48"
JWT_EXPIRES_IN="7d"

# Signs the auth + OAuth state cookies. Must be at least 32 characters.
# Use a DIFFERENT value from JWT_SECRET. Generate with: openssl rand -base64 48
COOKIE_SECRET="change-me-generate-with-openssl-rand-base64-48"

# OpenRouter AI (question generation and PDF embeddings).
# Without it, AI generation answers 503 and PDF uploads fail.
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# Stripe (not used by any code yet)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_ENTERPRISE=""

# Application
PORT=3001
NODE_ENV=development

# Public origin of the frontend. In production this MUST be the real https
# origin: it is the only allowed CORS origin, the OAuth redirect target, and
# the origin the session cookie is bound to.
FRONTEND_URL="http://localhost:3000"

# How many X-Forwarded-For entries your own proxies append in front of the API.
# The Next.js /api proxy adds one; an edge proxy in front of Next.js adds
# another. Unset trusts the left-most entry, which clients can forge, and the
# API logs a warning in production.
# TRUSTED_PROXY_HOPS=1

# Google OAuth. Required when NODE_ENV=production; without it in development
# the Google buttons answer "Google sign-in is not configured".
# The authorised redirect URI registered in the Google Cloud console must be
# exactly:  <FRONTEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email (verification codes, contact form). Required when
# NODE_ENV=production. In development, without a key, verification codes are
# printed to the API log instead of being emailed.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
# Where contact-form messages go. Defaults to RESEND_FROM_EMAIL.
SUPPORT_EMAIL=""

# Supabase Storage (optional). Without it, uploads are stored as base64 data
# URIs inside database rows, which is only suitable for development.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""
