# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/examai?schema=public"

# JWT — must be at least 32 characters (enforced at startup).
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-generate-with-openssl-rand-base64-48"
JWT_EXPIRES_IN="7d"

# Signs the auth + OAuth state cookies. Must be at least 32 characters.
# Use a DIFFERENT value from JWT_SECRET. Generate with: openssl rand -base64 48
COOKIE_SECRET="change-me-generate-with-openssl-rand-base64-48"

# OpenRouter AI
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# Stripe
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
STRIPE_PRICE_ID_PRO="price_your-pro-plan-price-id"
STRIPE_PRICE_ID_ENTERPRISE="price_your-enterprise-plan-price-id"

# Application
PORT=3001
NODE_ENV=development

# Public origin of the frontend. In production this MUST be the real https
# origin: it is the only allowed CORS origin, the OAuth redirect target, and
# the origin the session cookie is bound to.
FRONTEND_URL="http://localhost:3000"

# Google OAuth. Required when NODE_ENV=production.
# The authorised redirect URI registered in the Google Cloud console must be
# exactly:  <FRONTEND_URL>/api/auth/google/callback
# (it points at the frontend, which proxies /api/* to this backend, so the
# session cookie lands on the origin the browser actually talks to).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email (verification codes). The app fails to start without it.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Supabase Storage (optional - for file uploads)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_KEY="your-supabase-service-key"
