generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  engineType      = "library"
}

datasource db {
  provider = "postgresql"
}



model User {
  id                String        @id @default(uuid())
  email             String        @unique
  passwordHash      String?
  googleId          String?        @unique
  firstName         String
  lastName          String
  role              Role          @default(STUDENT)
  isActive          Boolean       @default(true)
  isEmailVerified   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  plan              Plan          @default(FREE)
  stripeCustomerId  String?       @unique
  attempts          Attempt[]
  createdCourses    Course[]      @relation("CourseCreator")
  uploadedMaterials Material[]    @relation("MaterialUploader")
  createdQuestions  Question[]    @relation("QuestionCreator")
  emailVerification EmailVerification?
  subscriptions     Subscription[]
  leaderboardEntries LeaderboardEntry[]

  @@index([email])
}

model Course {
  id             String       @id @default(uuid())
  name           String
  description    String?
  isPublic       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String
  createdBy      User         @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Cascade)
  materials      Material[]
  questions      Question[]
  leaderboardEntries LeaderboardEntry[]

  @@index([createdById])
}

model Material {
  id           String   @id @default(uuid())
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  createdAt    DateTime @default(now())
  courseId     String
  uploadedById String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Question {
  id          String    @id @default(uuid())
  content     String
  hint        String?
  contentType String    @default("text")
  imageUrl    String?
  aiGenerated Boolean   @default(false)
  approved    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  courseId    String
  createdById String
  answers     Answer[]
  attempts    Attempt[]
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([approved])
}

model Answer {
  id         String   @id @default(uuid())
  content    String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Attempt {
  id                String   @id @default(uuid())
  isCorrect         Boolean
  createdAt         DateTime @default(now())
  userId            String
  questionId        String
  selectedAnswerIds String[]
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@index([createdAt])
}

model LeaderboardEntry {
  id              String   @id @default(uuid())
  courseId        String
  userId          String?
  guestName       String?
  score           Int
  totalQuestions  Int
  percentage      Int
  completedAt     DateTime @default(now())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, percentage])
  @@index([userId])
}

model Subscription {
  id                   String             @id @default(uuid())
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
}



enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}
