generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  engineType      = "library"
}

datasource db {
  provider = "postgresql"
}



model User {
  id                String        @id @default(uuid())
  email             String        @unique
  passwordHash      String?
  googleId          String?        @unique
  firstName         String
  lastName          String
  role              Role          @default(STUDENT)
  isActive          Boolean       @default(true)
  isEmailVerified   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  plan              Plan          @default(FREE)
  stripeCustomerId  String?       @unique
  attempts          Attempt[]
  createdCourses    Course[]      @relation("CourseCreator")
  uploadedMaterials Material[]    @relation("MaterialUploader")
  createdQuestions  Question[]    @relation("QuestionCreator")
  emailVerification EmailVerification?
  subscriptions     Subscription[]
  leaderboardEntries LeaderboardEntry[]
  quizProgresses    QuizProgress[]

  @@index([email])
}

model Course {
  id             String       @id @default(uuid())
  name           String
  description    String?
  isPublic       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String
  createdBy      User         @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Cascade)
  materials      Material[]
  questions      Question[]
  leaderboardEntries LeaderboardEntry[]
  quizProgresses QuizProgress[]

  @@index([createdById])
}

model Material {
  id           String          @id @default(uuid())
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  chunkCount   Int             @default(0)
  createdAt    DateTime        @default(now())
  courseId     String
  uploadedById String
  course       Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy   User            @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  chunks       MaterialChunk[]

  @@index([courseId])
}

/// Embedded text chunks backing AI retrieval.
///
/// This model exists here so `prisma db push` and `migrate` create the table —
/// it previously lived only in hand-written SQL migrations, which meant any
/// database set up with `db push` silently lacked it and every upload failed
/// with "relation MaterialChunk does not exist".
///
/// `embedding` is Unsupported() because Prisma has no pgvector type. The
/// consequence is that Prisma Client cannot read or write that column, which is
/// why MaterialsService and RagService use raw SQL for it. The dimension must
/// stay in step with EmbeddingService.dimensions (512) — change one without the
/// other and every insert fails on a dimension mismatch.
///
/// CAVEAT: the HNSW index that makes similarity search fast cannot be declared
/// here, because Prisma cannot index an Unsupported column. It therefore lives
/// only in SQL, and `prisma db push` may drop it as an unknown object. If
/// retrieval suddenly gets slow, re-apply the repair migration — it recreates
/// the index idempotently:
///   npx prisma db execute --file prisma/migrations/20260811160000_repair_missing_objects/migration.sql
model MaterialChunk {
  id         String                       @id @default(uuid())
  content    String
  chunkIndex Int
  embedding  Unsupported("vector(512)")?
  createdAt  DateTime                     @default(now())
  materialId String
  material   Material                     @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
}

model Question {
  id          String    @id @default(uuid())
  content     String
  hint        String?
  contentType String    @default("text")
  imageUrl    String?
  aiGenerated Boolean   @default(false)
  approved    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  courseId    String
  createdById String
  answers     Answer[]
  attempts    Attempt[]
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([approved])
}

model Answer {
  id         String   @id @default(uuid())
  content    String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Attempt {
  id                String   @id @default(uuid())
  isCorrect         Boolean
  createdAt         DateTime @default(now())
  userId            String
  questionId        String
  selectedAnswerIds String[]
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@index([createdAt])
}

model LeaderboardEntry {
  id              String   @id @default(uuid())
  courseId        String
  userId          String?
  guestName       String?
  score           Int
  totalQuestions  Int
  percentage      Int
  completedAt     DateTime @default(now())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, percentage])
  @@index([userId])
}

model Subscription {
  id                   String             @id @default(uuid())
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
}



enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String
  expiresAt DateTime
  /// Failed submissions so far; the record is destroyed at OTP_MAX_ATTEMPTS
  /// so a 6-digit code cannot be enumerated.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

model QuizProgress {
  id             String   @id @default(uuid())
  userId         String
  courseId       String
  currentIndex   Int      @default(0)
  isCompleted    Boolean  @default(false)
  lastAnsweredAt DateTime @updatedAt
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}
